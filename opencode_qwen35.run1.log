            for (int i = 0; i < H; ++i) ss += double(xs[size_t(r) * H + i]) * xs[size_t(r) * H + i];
            float inv = float(1.0 / std::sqrt(ss / H + c.eps));
            for (int i = 0; i < H; ++i)
                xn[size_t(r) * H + i] =
