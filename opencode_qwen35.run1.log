+      LinearIn in;
+      in.name = lins[size_t(li)].name;
+      const std::vector<uint16_t>* w = lins[size_t(li)].w;
+      in.m = int(w->size()) / qcfg_.hidden;
+      if (std::string(lins[size_t(li)].name).find("in_proj_a") != std::string::npos) {
