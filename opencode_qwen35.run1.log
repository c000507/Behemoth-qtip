+            {"self_attn.v_proj", &QL->w_v},        {"self_attn.o_proj", &QL->w_o},
+            {"mlp.gate_proj", &QL->w_gate},        {"mlp.up_proj", &QL->w_up},
+            {"mlp.down_proj", &QL->w_down}};
+  } else {
+    lins = {{"linear_attn.in_proj_qkv", &QL->w_in_qkv}, {"linear_attn.in_proj_z", &QL->w_in_z},
+            {"linear_attn.in_proj_b", &QL->w_in_ba},    {"linear_attn.in_proj_a", nullptr},
+            {"linear_attn.out_proj", &QL->w_out},       {"mlp.gate_proj", &QL->w_gate},
+            {"mlp.up_proj", &QL->w_up},                 {"mlp.down_proj", &QL->w_down}};
+  }
+  // b/a live in one merged buffer [2*nv][H]: b = first nv rows, a = last nv rows
+  const std::vector<uint16_t> a_rows(QL->w_in_ba.begin() + size_t(qcfg_.lin_nv) * qcfg_.hidden, QL->w_in_ba.end());
+  struct Grp {
+    int hess;
+    std::vector<int> lins;
+  };
+  std::vector<Grp> groups = full ? std::vector<Grp>{{0, {0, 1, 2}}, {1, {3}}, {2, {4, 5}}, {3, {6}}}
