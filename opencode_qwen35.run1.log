        std::printf("layer %d (lin) post-attn: max|diff| %.5f scale %.3f rel %.2e -> %s\\n", layer,
                    maxd2, scale2, maxd2 / scale2, maxd2 / scale2 < 1.5e-1 ? "ok" : "FAIL");
        return maxd2 / scale2 < 1.5e-1 ? 0 : 1;
    }''')
