            std::vector<float> ringv(size_t(Wq) * c.conv_k, 0.0f);
            std::vector<float> Sv(size_t(nv) * kd * vd, 0.0f);
            auto sig = [](float x) { return 1.0f / (1.0f + std::exp(-x)); };
            auto sp = [](float x) { return x > 20.0f ? x : std::log(1.0f + std::exp(x)); };
