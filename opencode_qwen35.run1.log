template <class T> class DeviceBuffer {
    T *p_ = nullptr;
    size_t size_ = 0, capacity_ = 0;
    int device_ = 0;
    void release() noexcept {
        if (p_) {
            int current = 0;
            (void)hipGetDevice(&current);
            (void)hipSetDevice(device_);
            (void)hipFree(p_);
            (void)hipSetDevice(current);
        }
        p_ = nullptr;
        size_ = capacity_ = 0;
    }

  public:
    DeviceBuffer() = default;
    explicit DeviceBuffer(size_t n) {
        resize(n);
    }
    ~DeviceBuffer() {
        release();
    }
    DeviceBuffer(const DeviceBuffer &) = delete;
    DeviceBuffer &operator=(const DeviceBuffer &) = delete;
    DeviceBuffer(DeviceBuffer &&other) noexcept {
        swap(other);
    }
    DeviceBuffer &operator=(DeviceBuffer &&other) noexcept {
        if (this != &other) {
            release();
            swap(other);
        }
        return *this;
    }
    void swap(DeviceBuffer &other) noexcept {
        std::swap(p_, other.p_);
        std::swap(size_, other.size_);
        std::swap(capacity_, other.capacity_);
        std::swap(device_, other.device_);
    }
    void resize(size_t n) {
        if (n <= capacity_) {
            size_ = n;
            return;
        }
        release();
        HIP_CHECK(hipGetDevice(&device_));
        HIP_CHECK(hipMalloc(reinterpret_cast<void **>(&p_), checked_mul(n, sizeof(T))));
        size_ = capacity_ = n;
    }
    void upload(std::span<const T> x) {
        resize(x.size());
        if (!x.empty())
            HIP_CHECK(hipMemcpy(p_, x.data(), x.size_bytes(), hipMemcpyHostToDevice));
    }
    std::vector<T> download() const {
        std::vector<T> x(size_);
        if (size_)
            HIP_CHECK(hipMemcpy(x.data(), p_, size_ * sizeof(T), hipMemcpyDeviceToHost));
        return x;
    }
    T *data() {
        return p_;
    }
    const T *data() const {
        return p_;
    }
    size_t size() const {
        return size_;
    }
    size_t bytes() const {
        return size_ * sizeof(T);
    }
};
