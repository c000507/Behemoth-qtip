void hadamard(double *x, int n, bool transpose) {
    const int k = had_k(n), p = n / k;
    const int8_t *h = had_matrix(k);
    // matmul_hadU_cuda: view (K, n/K), natural-order FWHT on each row, then hadK @ rows.
