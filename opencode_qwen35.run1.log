s=s.replace("""  // final norm + lm_head
  std::vector<float> xf(size_t(T) * H);
  std::memcpy(xf.data(), x.data(), size_t(T) * H * 4);
  for (int t = 0; t < T; ++t) zc_norm_inplace(xf.data() + size_t(t) * H, final_norm.data(), H, cfg.eps);
